@model TheImmutableMed.Models.RadiologyImage

<h2>🩻 Upload Radiology Image</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div class="form-group">
        <label>Patient</label>
        <select asp-for="PatientId" class="form-control">
            <option value="0">Walk-in Patient</option>
        </select>
    </div>

    <div class="form-group">
        <label>Upload Image from PC</label>
        <input asp-for="ImageFile" type="file" class="form-control" />
    </div>

    <div class="form-group">
        <label>Notes</label>
        <input asp-for="AnalysisResult" class="form-control" />
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Upload</button>

</form>

<br />
<a asp-action="Index">Back to List</a>