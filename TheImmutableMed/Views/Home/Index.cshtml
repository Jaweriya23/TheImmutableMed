@{
    ViewData["Title"] = "The Immutable Med";
}

<div class="container-fluid p-5">

    <!-- HERO SECTION -->

    <div class="text-center mb-5">

        <h1 class="display-2 fw-bold text-primary">
            🏥 The Immutable Med
        </h1>

        <p class="lead text-secondary">
            Smart Hospital Management & Emergency Triage System
        </p>

    </div>

    <!-- MAIN BUTTONS -->

    <div class="row g-4">

        <div class="col-md-4">

            <a href="/Patients"
                   class="btn btn-success w-100 p-5 rounded-4 shadow-lg">

                <h2>🧑‍⚕️ Patients</h2>

                <p class="mt-3">
                    Manage patient records and emergency cases
                </p>

            </a>

        </div>

        <div class="col-md-4">

            <a href="/Doctors"
                   class="btn btn-primary w-100 p-5 rounded-4 shadow-lg">

                <h2>👨‍⚕️ Doctors</h2>

                <p class="mt-3">
                    Add, edit and manage doctors
                </p>

            </a>

        </div>

        <div class="col-md-4">

            <a href="/RadiologyImages"
                   class="btn btn-info text-white w-100 p-5 rounded-4 shadow-lg">

                <h2>🩻 Radiology</h2>

                <p class="mt-3">
                    MRI & CT image analysis system
                </p>

            </a>

        </div>

    </div>

    <!-- EMERGENCY SECTION -->

    <div class="alert alert-danger mt-5 shadow rounded-4">

        <h3>
            🚨 Emergency Triage Legacy Integration
        </h3>

        <p>
            Legacy hospital systems may become slow during emergencies.
            The Immutable Med uses caching, defensive coding and optimized
            workflows for critical patients.
        </p>

    </div>

</div>